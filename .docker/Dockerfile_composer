ARG BASE_IMAGE=crpi-j5t8nqf1b869w80g.cn-shenzhen.personal.cr.aliyuncs.com/stratum/demo-octane:base-latest

#########################################################################################################
#### 构建镜像
#########################################################################################################
FROM ${BASE_IMAGE}

ARG COMPOSER_VERSION="2.9.5"

RUN set -eux; \
    # \
    # Disable Zend OpCache \
    rm -rf /tmp/opcache; mkdir -p /tmp/opcache; chmod -R 0777 /tmp/opcache; \
    rm -rf /usr/local/etc/php/conf.d/*opcache.ini; \
    { \
        php -r "echo version_compare(PHP_VERSION, '8.5.0', '<') ? 'zend_extension=opcache' . PHP_EOL : '; PHP 8.5+ 默认内置 opcache,无需 zend_extension=opcache' . PHP_EOL;"; \
        echo "opcache.enable=0"; \
        echo "opcache.enable_cli=0"; \
    } > /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini; \
    # \
    # Install composer runtime dependencies on Alpine \
    apk update; \
    apk add --no-cache git subversion unzip zip; \
    # \
    # Install Composer \
    if [ -n "$COMPOSER_VERSION" ]; then \
        curl -sfL https://getcomposer.org/installer | php -- --install-dir=/usr/bin --filename=composer --version="$COMPOSER_VERSION"; \
    else \
        curl -sfL https://getcomposer.org/installer | php -- --install-dir=/usr/bin --filename=composer; \
    fi; \
    chmod +x /usr/bin/composer; \
    # \
    # Clear \
    pecl clear-cache || true; \
    rm -rf "/tmp/opcache/*" "${LOG_PATH}/*"

CMD ["/usr/bin/composer"]
