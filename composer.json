{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hughcube/demo",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-zend-opcache": "*",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.20",
        "laravel/tinker": "^3.0",
        "tymon/jwt-auth": "^2.3",
        "jenssegers/agent": "^2.6",
        "yansongda/laravel-pay": "^3.7",
        "overtrue/laravel-wechat": "^8.0",
        "hughcube/id-card": "^1.0",
        "hughcube/profiler": "^1.0",
        "hughcube/laravel-wechat": "^2.2",
        "hughcube/laravel-alioss": "^1.0",
        "hughcube/laravel-octane": "^2.0",
        "hughcube/laravel-alifc": "^3.0",
        "hughcube/laravel-knight": "^6.0",
        "hughcube/laravel-dingtalk": "^1.0",
        "hughcube/laravel-alibabacloud": "^1.3"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "jetbrains/phpstorm-attributes": "^1.1",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5|^13.0",
        "reliese/laravel": "^1.4",
        "spatie/laravel-ignition": "^2.9",
        "swoole/ide-helper": "^6.0"
    },
    "suggest": {
        "ext-xhprof": "Required for performance profiling with hughcube/profiler"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Migrations\\": "database/migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "ide": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide:generate-mixin-helper"
        ],
        "style": [
            "phpcbf -p --standard=PSR2 app/ -v",
            "phpcs -p --standard=PSR2 app/ -v"
        ],
        "test": [
            "phpunit"
        ],
        "phpstan": [
            "phpstan analyse --configuration=phpstan.neon --memory-limit=-1"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/tinker",
                "nunomaduro/termwind"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true,
            "hughcube/composer-proxy-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
